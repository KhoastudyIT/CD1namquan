{
	"info": {
		"_postman_id": "namquan-backend-api-v1",
		"name": "NAM QUAN — Furniture Store API",
		"description": "Bộ sưu tập Postman API đầy đủ cho hệ thống Nội thất NAM QUAN (Backend Node.js + Express)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000/api/v1",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Auth (Xác thực)",
			"item": [
				{
					"name": "Đăng nhập (Admin / User)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set('token', jsonData.data.token);",
									"    console.log('Tự động lưu Token:', jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@namquan.vn\",\n  \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Đăng nhập hệ thống. Sau khi đăng nhập thành công, script sẽ tự động lưu `token` vào biến môi trường để dùng cho các API yêu cầu xác thực."
					}
				},
				{
					"name": "Đăng ký tài khoản",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Nguyễn Văn A\",\n  \"email\": \"khachhang@gmail.com\",\n  \"password\": \"123456\",\n  \"phone\": \"0912345678\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"register"
							]
						}
					}
				},
				{
					"name": "Thông tin cá nhân (Me)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"me"
							]
						}
					}
				},
				{
					"name": "Cập nhật hồ sơ",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Nguyễn Văn A (Đã sửa)\",\n  \"phone\": \"0988888888\",\n  \"address\": \"123 Nguyễn Trãi, Quận 1, TP.HCM\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"me"
							]
						}
					}
				},
				{
					"name": "Đổi mật khẩu",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"oldPassword\": \"123456\",\n  \"newPassword\": \"654321\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/password",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"password"
							]
						}
					}
				},
				{
					"name": "Đăng xuất",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/logout",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"logout"
							]
						}
					}
				}
			]
		},
		{
			"name": "2. Products (Sản phẩm)",
			"item": [
				{
					"name": "Danh sách sản phẩm (Phân trang 15 / trang)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/products?page=1&limit=15&sort=newest",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"products"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "15"
								},
								{
									"key": "sort",
									"value": "newest"
								}
							]
						}
					}
				},
				{
					"name": "Chi tiết sản phẩm",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/products/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"products",
								"1"
							]
						}
					}
				},
				{
					"name": "Sản phẩm Flash Sale",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/products/flash-sales",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"products",
								"flash-sales"
							]
						}
					}
				},
				{
					"name": "Tạo sản phẩm mới (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Ghế Sofa Da Cao Cấp Nam Quan\",\n  \"type\": \"Sofa\",\n  \"price\": 18500000,\n  \"categoryId\": 1,\n  \"stock\": 20,\n  \"description\": \"Ghế sofa bọc da nhập khẩu phong cách hiện đại\",\n  \"colors\": [\"Nâu\", \"Đen\"],\n  \"style\": \"Hiện đại\",\n  \"materials\": [\"Da thật\"],\n  \"sizes\": [\"3 chỗ\"],\n  \"brand\": \"Nam Quan\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/products",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"products"
							]
						}
					}
				}
			]
		},
		{
			"name": "3. Categories & Collections",
			"item": [
				{
					"name": "Danh sách danh mục sản phẩm",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/categories",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"categories"
							]
						}
					}
				},
				{
					"name": "Danh sách bộ sưu tập",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/collections",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"collections"
							]
						}
					}
				}
			]
		},
		{
			"name": "4. Cart & Orders (Giỏ hàng & Đơn hàng)",
			"item": [
				{
					"name": "Xem giỏ hàng",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/cart",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"cart"
							]
						}
					}
				},
				{
					"name": "Thêm sản phẩm vào giỏ hàng",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"productId\": 1,\n  \"quantity\": 2\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/cart",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"cart"
							]
						}
					}
				},
				{
					"name": "Tạo đơn hàng mới (Thanh toán)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerName\": \"Nguyễn Văn A\",\n  \"customerPhone\": \"0912345678\",\n  \"shippingAddress\": \"456 Lê Lợi, Quận 1, TP.HCM\",\n  \"paymentMethod\": \"COD\",\n  \"note\": \"Giao hàng ngoài giờ hành chính\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"orders"
							]
						}
					}
				},
				{
					"name": "Danh sách đơn hàng của tôi",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/orders",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"orders"
							]
						}
					}
				}
			]
		},
		{
			"name": "5. News & Stats (Tin tức & Thống kê)",
			"item": [
				{
					"name": "Danh sách tin tức",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/news?limit=10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"news"
							],
							"query": [
								{
									"key": "limit",
									"value": "10"
								}
							]
						}
					}
				},
				{
					"name": "Báo cáo thống kê (Admin)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/stats/overview",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"stats",
								"overview"
							]
						}
					}
				},
				{
					"name": "Thông tin cấu hình công ty (Settings)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/settings",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"settings"
							]
						}
					}
				}
			]
		}
	]
}
