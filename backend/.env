PORT=3000
NODE_ENV=development
JWT_SECRET=nam-quan-dev-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Cấu hình kết nối PostgreSQL
# Nếu mật khẩu của bạn khác "postgres", hãy sửa ở đây:
# Cổng 5433 = cổng host mà Docker map ra (xem docker-compose.yml: "5433:5432")
DATABASE_URL=postgresql://postgres:123456@localhost:5433/nam_quan

# Lưu trữ ảnh bài viết (MinIO) — chạy: docker compose up -d minio
# Console quản trị: http://localhost:9001 (minioadmin / minioadmin)
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_BUCKET=namquan