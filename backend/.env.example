# Sao chép thành .env khi chạy backend NGOÀI Docker (local):
#   cp .env.example .env
# Khi chạy bằng docker compose, các biến này được cấp qua docker-compose.yml.

PORT=3000
NODE_ENV=development
JWT_SECRET=nam-quan-dev-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# PostgreSQL — sửa user/password/db cho khớp máy bạn
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nam_quan

# ── Lưu trữ ảnh (MinIO) ──────────────────────────────────────────────────────
# Bỏ trống cả 3 biến ENDPOINT/ACCESS_KEY/SECRET_KEY = tắt tính năng tải ảnh lên;
# backend vẫn chạy bình thường, chỉ endpoint xin URL upload trả 503.
# Khởi động MinIO: docker compose up -d minio  (console http://localhost:9001)
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_BUCKET=namquan
