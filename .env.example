# Biến môi trường cho docker-compose (đặt cạnh docker-compose.yml).
# Sao chép thành .env rồi sửa:  cp .env.example .env
#
# CHẠY LOCAL: giữ nguyên mặc định, không cần tạo .env.
# CHẠY TRÊN VPS: đổi hết mật khẩu và thay tên miền bên dưới cho khớp thực tế.

# ── Bí mật — PHẢI đổi khi chạy trên VPS ──────────────────────────────────────
# Sinh chuỗi ngẫu nhiên:  openssl rand -base64 32
POSTGRES_PASSWORD=doi_mat_khau_nay
JWT_SECRET=doi_chuoi_bi_mat_nay
MINIO_ROOT_USER=namquan_admin
MINIO_ROOT_PASSWORD=doi_mat_khau_nay

# ── Cổng nội bộ (Nginx Proxy Manager gọi vào qua loopback) ───────────────────
# BIND_IP=127.0.0.1 là dòng QUAN TRỌNG NHẤT của file này khi chạy trên VPS:
# thiếu nó thì Postgres, MinIO và API lộ thẳng ra Internet cho mọi người dò.
# Bỏ trống hoặc xoá dòng này = nghe trên mọi interface (chỉ hợp khi chạy local).
BIND_IP=127.0.0.1

# Đổi nếu cổng đó đã có dịch vụ khác trên VPS dùng. Kiểm tra: sudo ss -tlnp
API_PORT=3033
WEB_PORT=5173

# ── Tên miền công khai ───────────────────────────────────────────────────────
# Ba subdomain cần trỏ A record về IP VPS và tạo Proxy Host tương ứng trong NPM.
#
# VITE_API_URL được NHÚNG LÚC BUILD frontend — đổi giá trị này thì phải chạy lại
# `up -d --build frontend`, restart không ăn thua.
VITE_API_URL=https://api-namquan.dienlanhkv.website/api/v1

# Backend chỉ nhận request từ origin này. Nếu frontend deploy cả trên Vercel,
# liệt kê thêm domain Vercel, ngăn cách bằng dấu phẩy.
CORS_ORIGIN=https://namquan.dienlanhkv.website

# Địa chỉ trình duyệt dùng để tải/xem ảnh. Chữ ký upload ký theo host này nên
# phải khớp tuyệt đối với domain trong NPM — sai là MinIO báo SignatureDoesNotMatch.
MINIO_PUBLIC_URL=https://storage-namquan.dienlanhkv.website

# Origin được phép PUT thẳng lên MinIO từ trình duyệt
STORAGE_CORS_ORIGINS=https://namquan.dienlanhkv.website

# ── Tuỳ chọn ─────────────────────────────────────────────────────────────────
MINIO_PUBLIC_BUCKET=namquan
