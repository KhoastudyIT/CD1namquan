# Biến môi trường cho docker-compose (đặt cạnh docker-compose.yml).
# Sao chép thành .env rồi sửa:  cp .env.example .env
#
# CHẠY LOCAL: giữ nguyên mặc định, không cần file .env.
# CHẠY TRÊN VPS: bắt buộc đổi hết mật khẩu bên dưới và thay <IP-VPS> bằng IP thật.

# ── Bí mật — PHẢI đổi khi chạy trên VPS ──────────────────────────────────────
# Sinh chuỗi ngẫu nhiên:  openssl rand -base64 32
POSTGRES_PASSWORD=doi_mat_khau_nay
JWT_SECRET=doi_chuoi_bi_mat_nay
MINIO_ROOT_USER=namquan_admin
MINIO_ROOT_PASSWORD=doi_mat_khau_nay

# ── Cổng publish ra máy chủ ──────────────────────────────────────────────────
# Cổng 3000 trên VPS đã có web API khác dùng nên đổi sang 3033.
# Bên trong container backend vẫn nghe 3000 — chỉ cổng ra ngoài đổi.
API_PORT=3033

# ── Địa chỉ công khai ────────────────────────────────────────────────────────
# Thay <IP-VPS> bằng IP thật của máy chủ, ví dụ 203.0.113.10
# Cổng ở đây phải khớp API_PORT bên trên.
#
# VITE_API_URL được NHÚNG LÚC BUILD frontend — đổi giá trị này thì phải
# build lại frontend, restart không ăn thua.
VITE_API_URL=http://<IP-VPS>:3033/api/v1

# Backend chỉ nhận request từ origin này
CORS_ORIGIN=http://<IP-VPS>:5173

# Địa chỉ trình duyệt dùng để tải/xem ảnh. Chữ ký upload được ký theo host này
# nên sai một ký tự là MinIO từ chối — không được để localhost khi chạy VPS.
MINIO_PUBLIC_URL=http://<IP-VPS>:9000

# Origin được phép PUT thẳng lên MinIO từ trình duyệt
STORAGE_CORS_ORIGINS=http://<IP-VPS>:5173

# ── Tuỳ chọn ─────────────────────────────────────────────────────────────────
MINIO_PUBLIC_BUCKET=namquan
